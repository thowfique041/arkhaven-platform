# Server
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (no trailing slash)
CLIENT_ORIGINS=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/arkhaven?retryWrites=true&w=majority

# Auth: use a long random string (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# One-time Super Admin bootstrap over HTTP (optional). Leave empty to disable the endpoint.
BOOTSTRAP_TOKEN=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=arkhaven
